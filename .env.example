APP_ENV=development
HTTP_PORT=8085
# Base64 PEM PUBLIC key of atm-auth-api, never its private key.
AUTH_PUBLIC_KEY_BASE64=
# Must match JWT_ISSUER of atm-auth-api.
AUTH_ISSUER=atm-auth-dev
# Auth system codes whose service token may call this service (comma separated).
ALLOWED_SYSTEMS=lavendimia
# Documents rendered at the same time; the rest wait until a slot frees up.
MAX_CONCURRENT_RENDERS=4
# Upper bound for one request, rendering included.
RENDER_TIMEOUT=15s
