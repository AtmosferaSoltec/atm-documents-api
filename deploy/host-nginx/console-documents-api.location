# Added inside the `server` block of /etc/nginx/sites-available/console.atmosferast.com,
# before `location /`. The console calls the documents API on its own origin under
# /documents-api (the trailing slash in proxy_pass removes that prefix), like /storage-api.
	location /documents-api/ {
		client_max_body_size 5m;
		proxy_pass http://127.0.0.1:3133/;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $auth_client_ip;
		proxy_set_header X-Forwarded-For $auth_client_ip;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 35s;
		proxy_send_timeout 35s;
	}
